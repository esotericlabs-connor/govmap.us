# GovMap environment template for docker-compose.PaaS.yml. Configure these
# values in the deployment platform, or copy to a private .env for Compose.
# NEVER commit the real .env (it's gitignored). Keep current configuration
# and recovery credentials in a protected vault separate from the server.
# Database and logs must be restored from backups; environment variables
# and a working tunnel do not recover them. See docs/backup-service.md.

# Required. For an existing Postgres volume, changing this variable does NOT
# change the database role password. Coordinate rotation with the database
# role and all clients (backend and backup); never delete the volume to rotate.
POSTGRES_PASSWORD=

# Required. Cloudflare Tunnel token for this environment's dashboard-managed
# tunnel. Production and test use separate tunnels. Get it from the matching
# tunnel's connector setup. Rotate only that tunnel's token and redeploy its
# connector; retain the routes and DNS configuration.
# The PaaS Compose file rejects deployment when this required value is empty.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional — unlock the /internal/* ops endpoints (locked when unset).
INTERNAL_USER=
INTERNAL_PASSWORD=

# Optional pipeline-failure notification URL; treat it as a secret.
ALERT_WEBHOOK_URL=

# Keep enabled in production. Set false for snapshot-only test environments.
# Manual refresh commands and request-triggered fetches are not disabled.
SCHEDULER_ENABLED=true

# Interactive API docs (/docs, /redoc, /openapi.json). Off by default because
# the schema maps every route; keep false on public deployments.
API_DOCS_ENABLED=false

# Non-secret build stamp for backend/frontend health responses. The deployment
# platform supplies SOURCE_COMMIT; enable its availability during Docker builds.
# For manual Compose builds set the full 40-character lowercase Git SHA.
# Do not set APP_COMMIT_SHA at runtime to disguise an older image.
# SOURCE_COMMIT=unknown

# Congress.gov API key — required for the bills and Congress.gov vote pipelines.
# Free + instant from https://api.congress.gov/sign-up/. Without it the bills
# refresh records an error (the rest of the stack runs fine).
CONGRESS_GOV_API_KEY=

# OpenFEC key from https://api.data.gov/signup/.
FEC_API_KEY=
FEC_CYCLE=2026

# HUD USPS ZIP-to-district crosswalk token.
HUD_API_TOKEN=

# Container backup services. Enable only for the intended environment.
# Bootstrap the pgBackRest stanza before enabling WAL archiving; see
# docs/backup-service.md for rollout, Duplicati and restore steps.
BACKUP_ENABLED=false
BACKUP_TARGET=unconfigured
BACKUP_TIME_UTC=02:30
BACKUP_INTERVAL_MINUTES=1440
BACKUP_HEARTBEAT_URL=
PGBACKREST_ENABLED=false
PGBACKREST_TIME_UTC=03:30
PGBACKREST_ARCHIVE_HEARTBEAT_URL=
PGBACKREST_BACKUP_HEARTBEAT_URL=

# Cloudflare Turnstile keys for the bug-report widget (optional — the form
# works without them; when both are set the widget appears and the backend
# verifies each submission). Get a free pair from the Cloudflare dashboard ->
# Turnstile -> add a site. Both MUST live here so docker-compose can inject
# them (the site key is baked into the frontend build arg, the secret key into
# the backend container env). Supply both through the deployment settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only proxy socket-peer CIDRs that overwrite CF-Connecting-IP with a verified
# client address may be trusted. Empty = use the socket peer for report limits.
# Do not trust an entire shared container network without verifying its peers.
TRUSTED_PROXY_CIDRS=

# Optional overrides (production defaults live in docker-compose.PaaS.yml):
# CORS_ORIGINS=https://govmap.us
# NEXT_PUBLIC_API_URL=http://backend:8000
# NEXT_PUBLIC_APP_URL=https://govmap.us
# NEXT_PUBLIC_MARKETING_URL=https://govmap.us
# NEXT_PUBLIC_API_URL is a frontend build argument. Do not set it to the
# frontend's own public hostname: the API rewrite would proxy to itself.
# CONGRESS_NUMBER=119            # bump to 120 in Jan 2027
# CONGRESS_SESSION=2             # 1=first year (2025), 2=second (2026); set 1 in Jan 2027
# CONGRESS_GOV_BILL_LIMIT=250    # raise to widen bill coverage per refresh
# CONGRESS_GOV_BILLS_MAX_SECONDS=600   # bills pull time budget (60-1500); keep under the 15m deploy refresh cap
# CONGRESS_MAX_CONSECUTIVE_FAILURES=5  # consecutive Congress.gov timeouts before a batch stops early
# VOTES_LIMIT=100                # most-recent roll calls pulled per chamber
# VOTEVIEW_MIN_REFETCH_HOURS=6   # reuse a staged Voteview Senate fallback pull this long (0-24)
# UPSTREAM_MAX_CONCURRENT_REQUESTS=4
# Legacy compose only (PaaS uses API_* / WORKER_* shares below):
# CONGRESS_REQUESTS_PER_HOUR=4500
# FEC_REQUESTS_PER_HOUR=900
# GOVINFO_REQUESTS_PER_HOUR=600
# API_CONGRESS_REQUESTS_PER_HOUR=1000
# WORKER_CONGRESS_REQUESTS_PER_HOUR=3500
# API_FEC_REQUESTS_PER_HOUR=250
# WORKER_FEC_REQUESTS_PER_HOUR=650
# API_GOVINFO_REQUESTS_PER_HOUR=500
# WORKER_GOVINFO_REQUESTS_PER_HOUR=100
# PostgreSQL-enforced totals, identical in every process using this database:
# TOTAL_CONGRESS_REQUESTS_PER_HOUR=4500
# TOTAL_FEC_REQUESTS_PER_HOUR=900
# TOTAL_GOVINFO_REQUESTS_PER_HOUR=600
