# Postgres connection string (async driver — asyncpg)
DATABASE_URL=postgresql+asyncpg://govmap:govmap@localhost:5432/govmap

# Comma-separated list of origins the API will accept browser requests from
CORS_ORIGINS=http://localhost:3000,https://govmap.us

# Keep enabled in production. Disable scheduled refreshes for snapshot-only tests.
# This does not disable manual refresh commands or request-triggered fetches.
SCHEDULER_ENABLED=true

# Interactive API docs (/docs, /redoc, /openapi.json). Off by default because
# the schema maps every route; enable only for local development.
API_DOCS_ENABLED=false

# Empty by default: never trust client-supplied forwarding headers.
# Configure only known proxy peer CIDRs that overwrite CF-Connecting-IP.
TRUSTED_PROXY_CIDRS=

# PostgreSQL-backed rolling-hour limits; API, worker and manual processes share
# usage. Standalone/legacy processes use shared; PaaS fixes api/worker in Compose.
UPSTREAM_MAX_CONCURRENT_REQUESTS=4
UPSTREAM_BUDGET_SCOPE=shared
CONGRESS_REQUESTS_PER_HOUR=4500
FEC_REQUESTS_PER_HOUR=900
GOVINFO_REQUESTS_PER_HOUR=600
TOTAL_CONGRESS_REQUESTS_PER_HOUR=4500
TOTAL_FEC_REQUESTS_PER_HOUR=900
TOTAL_GOVINFO_REQUESTS_PER_HOUR=600

# Congress.gov outage bounds: the bills pull's time budget in seconds, and how
# many consecutive timeouts/connection failures stop a batch pull early.
CONGRESS_GOV_BILLS_MAX_SECONDS=600
CONGRESS_MAX_CONSECUTIVE_FAILURES=5

# Reuse validated Voteview Senate fallback staging for this many hours.
# Fallback status remains partial; 0 forces a new download.
VOTEVIEW_MIN_REFETCH_HOURS=6

# Credentials for the /internal/* ops endpoints (pipeline status dashboard).
# Leave both empty to keep those endpoints locked (recommended unless you need
# them). Set to access /internal/pipeline-status with HTTP Basic Auth.
INTERNAL_USER=
INTERNAL_PASSWORD=
