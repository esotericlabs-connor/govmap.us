# Top-level runtime dependencies: the only file to edit by hand.
#
# requirements.txt is compiled from this file into a fully resolved,
# hash-pinned lock (every transitive package, every artifact hash), so a build
# installs exactly what CI audited and nothing a compromised or re-published
# upstream release could swap in. CI's backend-audit job compiles it on every
# push and uploads it as the `backend-lock-<sha>` artifact; commit that file
# as backend/requirements.txt. Dependabot regenerates both files together.
# tests/test_dependency_pins.py fails if the two disagree on a pin.
fastapi==0.162.2
# Pinned explicitly: FastAPI only sets a floor, and 1.3.1 is the first release
# clear of the multipart/form, Host-header and HTTPEndpoint advisories.
starlette==1.10.0
